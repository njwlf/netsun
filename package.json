{
  "name": "qingji-cloudflare-manual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/build-worker.mjs && wrangler dev",
    "deploy": "node scripts/build-worker.mjs && wrangler deploy",
    "db:apply": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  }
}
