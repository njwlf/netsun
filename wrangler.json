{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qingji-manager",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qingji-db",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "qingji-backups"}],
  "triggers": {"crons": ["0 19 * * *"]},
  "vars": {"DAILY_BACKUP_TIME": "03:00 Asia/Shanghai"},
  "observability": {"enabled": true}
}
